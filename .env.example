# Copy to .env for local development. NEVER commit the real .env file.
# On EC2 these are set in /etc/environment or the systemd unit instead.

# Port the Express app listens on
PORT=3000

# 'local' writes uploads to ./local-storage (local development/tests only)
# 's3' uploads to the private bucket below using the AWS SDK credential chain
STORAGE_MODE=local

# Required when STORAGE_MODE=s3
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=pickleball-reports-<your-unique-suffix>

# Vercel only: use a narrowly scoped IAM user (or another supported AWS
# credential provider), never frontend variables. EC2 continues using its
# instance role through the AWS SDK default credential chain.
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=... # only for temporary credentials

# Admin bearer token for the /api/admin endpoints.
# If unset, a random token is generated at startup and printed to the server log
# (prototype only — documented as such in docs/report).
ADMIN_TOKEN=change-me-to-a-long-random-string

# local | production  (production hides internal error details from clients)
NODE_ENV=development

# Optional CORS allow-list for a separately hosted frontend (e.g. Vercel).
# Leave unset to disable CORS entirely (local development uses the Vite proxy).
# Must be exactly one origin, with scheme and no trailing slash:
# ALLOWED_ORIGIN=https://courtly.example.com
