# Copy to .env for local development. NEVER commit the real .env file.
# On EC2 these are set in /etc/environment or the systemd unit instead.

# Port the Express app listens on
PORT=3000

# 'local' writes uploads to ./local-storage (no AWS needed)
# 's3' uploads to the bucket below using the EC2 instance role
STORAGE_MODE=local

# Only used when STORAGE_MODE=s3 (set this on EC2)
# AWS_S3_BUCKET=pickleball-reports-<your-unique-suffix>

# Admin bearer token for the /api/admin endpoints.
# If unset, a random token is generated at startup and printed to the server log
# (prototype only — documented as such in docs/report).
ADMIN_TOKEN=change-me-to-a-long-random-string

# local | production  (production hides internal error details from clients)
NODE_ENV=development
