# ---- Local environment (copy to .env) ----
# Leave VITE_API_BASE_URL empty in local development to use the Vite dev
# proxy (recommended): requests to /api are forwarded to VITE_DEV_PROXY_TARGET.
#
# For a direct cross-origin setup, set this to the API origin and configure
# the backend ALLOWED_ORIGIN variable to match this frontend origin.
VITE_API_BASE_URL=

# Vite dev proxy target (used only by `npm run dev`, never bundled)
VITE_DEV_PROXY_TARGET=http://localhost:3000

# ---- Production / Vercel ----
# Set VITE_API_BASE_URL in the Vercel project settings to a secure HTTPS API
# endpoint, for example:
#   VITE_API_BASE_URL=https://api.your-domain.example
#
# NEVER put the admin token, AWS keys, or any secret in a VITE_ variable.
# VITE_ variables are embedded in the public JavaScript bundle.
